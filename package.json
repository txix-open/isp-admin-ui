{
  "name": "isp-admin-ui",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 vite build && node generateVersionFile.cjs",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "fix:prettier": "prettier --write \"src/**/*.{ts,tsx, js}\"",
    "lint:fix": "eslint --fix .",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "prepare": "husky || true",
    "test:dependencies": "vite build --config tests/dependency-smoke.config.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@reduxjs/toolkit": "^2.2.3",
    "axios": "^1.20.0",
    "buffer": "^6.0.3",
    "dayjs": "^1.11.10",
    "isp-admin-ui-kit": "^1.16.0",
    "isp-ui-kit": "^2.3.3",
    "monaco-editor": "^0.55.1",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.2",
    "react-redux": "^9.1.0",
    "react-resizable": "^3.0.5",
    "react-router-dom": "^7.18.6",
    "simplebar": "^6.2.5",
    "simplebar-react": "^3.2.4",
    "stream-http": "^3.2.0",
    "url": "^0.11.4"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/deep-equal": "^1.0.4",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^20.12.4",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.24",
    "@types/react-resizable": "^3.0.7",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitejs/plugin-react": "^4.2.1",
    "antd": "6.4.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "husky": "^9.0.11",
    "prettier": "^3.2.5",
    "sass": "1.74.1",
    "terser": "^5.30.3",
    "typescript": "^5.4.3",
    "vite": "^6.4.6",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-style-import": "^2.0.0",
    "vite-plugin-svgr": "^4.2.0",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "eslint --fix .",
      "pre-push": "eslint --fix ."
    }
  },
  "overrides": {
    "dompurify": "~3.4.18",
    "katex": "~0.18.2",
    "minimatch@>=7 <11": "^11.0.1",
    "glob@>=9 <14.0.2": "^14.0.2",
    "react-router-dom": "$react-router-dom"
  }
}
